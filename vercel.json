{
  "version": 2,
  "rewrites": [
    { "source": "/api/register",          "destination": "/api/auth?action=register" },
    { "source": "/api/login",             "destination": "/api/auth?action=login" },
    { "source": "/api/logout",            "destination": "/api/auth?action=logout" },
    { "source": "/api/forgot-password",   "destination": "/api/auth?action=forgot-password" },
    { "source": "/api/reset-password",    "destination": "/api/auth?action=reset-password" },
    { "source": "/api/auth/google/config","destination": "/api/auth?action=google-config" },
    { "source": "/api/auth/google",       "destination": "/api/auth?action=google" },
    { "source": "/api/songs/:id/play",    "destination": "/api/songs/[id]?action=play" },
    { "source": "/api/songs/:id/like",    "destination": "/api/songs/[id]?action=like" },
    { "source": "/api/songs/:id/dislike", "destination": "/api/songs/[id]?action=dislike" },
    { "source": "/api/songs/:id/listen",  "destination": "/api/songs/[id]?action=listen" },
    { "source": "/api/songs/:id",         "destination": "/api/songs/[id]" },
    { "source": "/api/playlists/:id/songs/:sid", "destination": "/api/playlists/[id]?action=removeSong&sid=:sid" },
    { "source": "/api/playlists/:id/songs", "destination": "/api/playlists/[id]" },
    { "source": "/api/playlists/:id",     "destination": "/api/playlists/[id]" },
    { "source": "/api/history/back",      "destination": "/api/history?action=back" },
    { "source": "/api/search",            "destination": "/api/search" },
    { "source": "/api/:path*",            "destination": "/api/:path*" },
    { "source": "/((?!api/).*)",          "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,X-User-Id,X-Host-Token" },
        { "key": "Vary",                         "value": "Origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
