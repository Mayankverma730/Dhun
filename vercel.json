{
  "version": 2,
  "redirects": [
    { "source": "/:file.c", "destination": "/", "permanent": false },
    { "source": "/:file.h", "destination": "/", "permanent": false },
    { "source": "/:file.exe", "destination": "/", "permanent": false },
    { "source": "/:file.o", "destination": "/", "permanent": false },
    { "source": "/:file.obj", "destination": "/", "permanent": false },
    { "source": "/:file.sh", "destination": "/", "permanent": false },
    { "source": "/:file.bat", "destination": "/", "permanent": false },
    { "source": "/:file.cmd", "destination": "/", "permanent": false },
    { "source": "/:file.log", "destination": "/", "permanent": false },
    { "source": "/:file.env", "destination": "/", "permanent": false },
    { "source": "/:file.yml", "destination": "/", "permanent": false },
    { "source": "/:file.yaml", "destination": "/", "permanent": false },
    { "source": "/Makefile", "destination": "/", "permanent": false },
    { "source": "/Dockerfile", "destination": "/", "permanent": false },
    { "source": "/:dir/:file.c", "destination": "/", "permanent": false },
    { "source": "/:dir/:file.h", "destination": "/", "permanent": false },
    { "source": "/:dir/:file.exe", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/songs/:id/play",    "destination": "/api/songs/[id]?action=play" },
    { "source": "/api/songs/:id/like",    "destination": "/api/songs/[id]?action=like" },
    { "source": "/api/songs/:id/dislike", "destination": "/api/songs/[id]?action=dislike" },
    { "source": "/api/songs/:id/listen",  "destination": "/api/songs/[id]?action=listen" },
    { "source": "/api/songs/:id",         "destination": "/api/songs/[id]" },
    { "source": "/api/playlists/:id/songs/:sid", "destination": "/api/playlists/[id]?action=removeSong&sid=:sid" },
    { "source": "/api/playlists/:id/songs", "destination": "/api/playlists/[id]" },
    { "source": "/api/playlists/:id",     "destination": "/api/playlists/[id]" },
    { "source": "/api/history/back",      "destination": "/api/history?action=back" },
    { "source": "/api/search",            "destination": "/api/search" }
  ]
}
