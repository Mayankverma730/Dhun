{
  "version": 2,
  "redirects": [
    { "source": "/test_dsa.c", "destination": "/", "permanent": false },
    { "source": "/server.c", "destination": "/", "permanent": false },
    { "source": "/benchmark.c", "destination": "/", "permanent": false },
    { "source": "/main.c", "destination": "/", "permanent": false },
    { "source": "/avl.c", "destination": "/", "permanent": false },
    { "source": "/bst.c", "destination": "/", "permanent": false },
    { "source": "/hash.c", "destination": "/", "permanent": false },
    { "source": "/heap.c", "destination": "/", "permanent": false },
    { "source": "/queue.c", "destination": "/", "permanent": false },
    { "source": "/stack.c", "destination": "/", "permanent": false },
    { "source": "/trie.c", "destination": "/", "permanent": false },
    { "source": "/graph.c", "destination": "/", "permanent": false },
    { "source": "/cache.c", "destination": "/", "permanent": false },
    { "source": "/logger.c", "destination": "/", "permanent": false },
    { "source": "/library.c", "destination": "/", "permanent": false },
    { "source": "/song.c", "destination": "/", "permanent": false },
    { "source": "/sort.c", "destination": "/", "permanent": false },
    { "source": "/playlist.c", "destination": "/", "permanent": false },
    { "source": "/Makefile", "destination": "/", "permanent": false },
    { "source": "/Dockerfile", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/songs/:id/play",    "destination": "/api/songs/[id]?action=play" },
    { "source": "/api/songs/:id/like",    "destination": "/api/songs/[id]?action=like" },
    { "source": "/api/songs/:id/dislike", "destination": "/api/songs/[id]?action=dislike" },
    { "source": "/api/songs/:id/listen",  "destination": "/api/songs/[id]?action=listen" },
    { "source": "/api/songs/:id",         "destination": "/api/songs/[id]" },
    { "source": "/api/playlists/:id/songs/:sid", "destination": "/api/playlists/[id]?action=removeSong&sid=:sid" },
    { "source": "/api/playlists/:id/songs", "destination": "/api/playlists/[id]" },
    { "source": "/api/playlists/:id",     "destination": "/api/playlists/[id]" },
    { "source": "/api/history/back",      "destination": "/api/history?action=back" },
    { "source": "/api/search",            "destination": "/api/search" },
    { "source": "/api/:path*",            "destination": "/api/:path*" },
    { "source": "/((?!api/).*)",          "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,X-User-Id,X-Host-Token" },
        { "key": "Vary",                         "value": "Origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
